# ============================================================================
# Backend Environment Configuration - TEMPLATE
# ============================================================================
#
# PURPOSE: 
#   This file shows all required environment variables for the Django backend.
#   DO NOT commit real values to git. Copy this file to .env and fill in YOUR
#   actual values locally.
#
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Edit .env with your actual values (never commit it)
#   3. source .env (Unix/Mac) or .\.env (PowerShell on Windows)
#   4. Make sure .env is in .gitignore (it should be)
#
# GENERATING SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# SECURITY NOTES:
#   - NEVER commit real database passwords
#   - NEVER commit real SECRET_KEY values
#   - NEVER commit real superuser passwords
#   - Always use strong, unique passwords for production
#   - Use environment variables instead of hardcoding secrets
#   - Rotate secrets regularly (especially after commits to public repos)
#
# ============================================================================

# ============================================================================
# DJANGO CORE CONFIGURATION
# ============================================================================

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECURITY: Unique per environment, never shared publicly
# Django settings read SECRET_KEY (DJANGO_SECRET_KEY is accepted as an alias in some loaders)
SECRET_KEY=your-super-secret-key-here-generate-new-one
DJANGO_SECRET_KEY=your-super-secret-key-here-generate-new-one

# Debug mode (MUST be False in production)
DEBUG=False

# Django settings module
DJANGO_SETTINGS_MODULE=pharmasys.settings_consolidated

# Comma-separated list of allowed hosts (check with: ipconfig or ifconfig)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.137,your-domain.com

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# PostgreSQL database name
DB_NAME=lizzymike_db

# PostgreSQL database user
DB_USER=pharma_user

# PostgreSQL database password (STRONG PASSWORD REQUIRED)
# Use uppercase, lowercase, numbers, and special characters
# Example: P@ssw0rd!Secure#2024
DB_PASSWORD=your-strong-database-password-here

# PostgreSQL host (localhost for development, server IP for production)
DB_HOST=localhost

# PostgreSQL port (default 5432)
DB_PORT=5432

# Database connection settings
DB_CONN_MAX_AGE=600
DB_CONN_TIMEOUT=10

# ============================================================================
# SUPERUSER / ADMIN ACCOUNT
# ============================================================================
#
# Used by: python manage.py createsuperuser
# SECURITY: Change these immediately after first login!
#

# Django superuser username
DJANGO_SUPERUSER_USERNAME=admin

# Django superuser email
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.local

# Django superuser password (STRONG PASSWORD REQUIRED)
# Use uppercase, lowercase, numbers, and special characters
DJANGO_SUPERUSER_PASSWORD=your-strong-admin-password-here

# ============================================================================
# CORS & CSRF CONFIGURATION
# ============================================================================
#
# Required for JavaScript/React frontend access from different origins
# Must include ALL IPs/domains clients use to access this server
# Format: http://ip:port or https://domain.com (comma-separated)
#

# CORS allowed origins (domains that can make API requests)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.137,http://your-domain.com

# CSRF trusted origins (additional security layer)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.137,http://your-domain.com

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
#
# For LAN deployment: Use console backend (logs to terminal)
# For production with SMTP: Update EMAIL_BACKEND and credentials
#

# Email backend: 'console' (development) or 'smtp' (production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Host (if using SMTP backend)
EMAIL_HOST=smtp.gmail.com

# SMTP Port (typically 587 for TLS, 465 for SSL)
EMAIL_PORT=587

# Use TLS for SMTP (True for most services)
EMAIL_USE_TLS=True

# SMTP username/email (often same as sender address)
EMAIL_HOST_USER=your-email@gmail.com

# SMTP password or app-specific password
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default sender email address
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# CELERY / TASK QUEUE CONFIGURATION (Optional)
# ============================================================================
#
# For background task processing (async jobs, scheduled tasks)
# Requires Redis to be installed and running
#

# Celery broker URL (message queue)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (stores task results)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# REDIS CONFIGURATION (Cache/Session Store - Optional)
# ============================================================================

# Redis URL for caching and session storage
REDIS_URL=redis://localhost:6379/1

# ============================================================================
# PHARMACY SETTINGS
# ============================================================================

# Pharmacy name (appears on receipts, reports, etc.)
PHARMACY_NAME=LizzyMike Pharmacy

# Pharmacy business address
PHARMACY_ADDRESS=123 Main Street, City, State 12345

# Pharmacy phone number
PHARMACY_PHONE=+1-555-0123

# Pharmacy license/registration number
PHARMACY_LICENSE=RX-123456

# Tax rate (as decimal: 0.03 = 3%)
PHARM_TAX_RATE=0.03

# ============================================================================
# AWS S3 CONFIGURATION (Optional - for file storage)
# ============================================================================
#
# Only needed if using AWS S3 for media files
# Leave blank/commented if using local file storage
#

# Enable S3 storage (True/False)
USE_S3=False

# AWS Access Key ID (keep secret!)
AWS_ACCESS_KEY_ID=your-aws-access-key

# AWS Secret Access Key (keep secret!)
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS S3 bucket name
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# AWS S3 region
AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# SENTRY CONFIGURATION (Optional - for error tracking)
# ============================================================================
#
# Only needed if using Sentry for error monitoring
#

# Sentry DSN (Data Source Name) - keep secret!
SENTRY_DSN=your-sentry-dsn-here

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Time zone (Django)
TIME_ZONE=UTC

# Language code
LANGUAGE_CODE=en-us

# Internationalization settings
USE_I18N=True
USE_TZ=True

# ============================================================================
# GUNICORN CONFIGURATION (Production)
# ============================================================================
#
# For production deployment with Gunicorn WSGI server
#

# Number of Gunicorn worker processes (rule: 2 * CPU_cores + 1)
GUNICORN_WORKERS=3

# Worker timeout in seconds
GUNICORN_TIMEOUT=120

# Bind address and port
GUNICORN_BIND=0.0.0.0:8000

# ============================================================================
# LOGGING CONFIGURATION (Optional)
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file directory
LOG_DIR=./logs

# ============================================================================
# FEATURES & FLAGS (Optional)
# ============================================================================

# Enable prescription digital signatures
ENABLE_DIGITAL_SIGNATURES=True

# Enable PDF receipt generation
ENABLE_PDF_RECEIPTS=True

# Enable audit trail logging
ENABLE_AUDIT_LOGGING=True

# Enable low-stock alerts
ENABLE_LOW_STOCK_ALERTS=True

# Low stock threshold percentage (0.2 = 20%)
LOW_STOCK_THRESHOLD=0.2
