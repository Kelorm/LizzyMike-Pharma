################################################################################
# DJANGO PHARMACY SYSTEM - ENVIRONMENT CONFIGURATION
# 
# Copy this file to Backend/.env and fill in your actual values.
# NEVER commit Backend/.env to version control - only commit this .env.example
#
# Most variables have sensible defaults. REQUIRED variables are marked as such.
################################################################################

# ============================================================================
# ENVIRONMENT TYPE (REQUIRED)
# ============================================================================
# Which environment are you running in? This affects security, database, logging, etc.
# Options: development | lan | production | free
# - development: Local SQLite, DEBUG=True, console email, all origins allowed
# - lan: Local PostgreSQL, HTTP (no SSL), LAN IPs, rate limiting, file logging
# - production: PostgreSQL, HTTPS required, S3 support, strict security, Sentry
# - free: PostgreSQL on free hosting (e.g., Render), HTTPS required, LocMemCache
DJANGO_ENV=development

# ============================================================================
# CORE DJANGO SETTINGS
# ============================================================================

# SECRET_KEY (REQUIRED for production/lan/free)
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# For development only, a default insecure key is used if not set
SECRET_KEY=your-super-secret-key-here-change-in-production

# Debug mode - NEVER set to True in production
# Options: True (development), False (production/lan/free)
DEBUG=False

# Allowed hosts (comma-separated)
# For development: localhost,127.0.0.1
# For LAN: 192.168.0.137,192.168.1.200,localhost,127.0.0.1
# For production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.137

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For development: uses SQLite by default (no config needed)
# For lan/production/free: PostgreSQL is required

# PostgreSQL Database Name
DB_NAME=lizzymike_db

# PostgreSQL User
DB_USER=pharma_user

# PostgreSQL Password (REQUIRED for lan/production/free)
# Use a strong password: 12+ characters, mix of uppercase, lowercase, numbers, symbols
# Example: Secure@Pass#2024LizzyMike
DB_PASSWORD=change-me-to-strong-password

# PostgreSQL Host
# For local development: localhost
# For LAN production: 192.168.0.137 or your server IP
# For cloud hosting: provided by your hosting provider
DB_HOST=localhost

# PostgreSQL Port
# Default: 5432 (standard PostgreSQL port)
DB_PORT=5432

# Database SSL mode
# - allow: allows plain HTTP connection (LAN only)
# - require: requires SSL (production/free hosting)
# - disable: disables SSL (development only)
DB_SSLMODE=allow

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# HTTPS redirect - forces all traffic to HTTPS (production/free only)
SECURE_SSL_REDIRECT=True

# HSTS header duration in seconds (production only)
# 31536000 = 1 year
SECURE_HSTS_SECONDS=31536000

# ============================================================================
# CORS CONFIGURATION (Frontend Integration)
# ============================================================================
# These control which frontend URLs can make API requests

# Comma-separated list of allowed frontend origins
# For development: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# For LAN: http://192.168.0.137,http://localhost:3000,http://192.168.0.137:3000
# For production: https://yourdomain.com
# Multiple origins: http://app1.com,http://app2.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated list of origins that can submit forms
# Should match CORS_ALLOWED_ORIGINS in most cases
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# JWT (JSON WEB TOKEN) CONFIGURATION
# ============================================================================
# Controls how long auth tokens last

# Access token lifetime in hours
# Shorter = more secure but requires more refreshes
# Typical: 12 hours for LAN, 1 hour for production
JWT_ACCESS_LIFETIME=12

# Refresh token lifetime in days
# Used to get a new access token without re-logging in
# Typical: 7 days
JWT_REFRESH_LIFETIME=7

# ============================================================================
# REST FRAMEWORK SETTINGS
# ============================================================================

# Results per page for paginated API endpoints
REST_PAGE_SIZE=20

# Rate limiting for anonymous users (requests/hour)
# Example: 100/hour means 100 requests per hour
REST_THROTTLE_ANON=100/hour

# Rate limiting for authenticated users (requests/hour)
REST_THROTTLE_USER=1000/hour

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Only needed for production; development uses console backend (prints to terminal)

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Email address shown as "From" in emails
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# REDIS & CACHING
# ============================================================================
# Redis is used for Celery tasks and caching
# Not needed for free hosting (uses LocMemCache instead)

# Redis URL for caching
# Format: redis://:password@host:port/db
# Local: redis://localhost:6379/0
# No password: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# CELERY (BACKGROUND TASKS)
# ============================================================================
# For async tasks like sending emails, generating reports

# Celery broker (where tasks are queued)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (where results are stored)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# INTERNATIONALIZATION
# ============================================================================

# Timezone for the application
# Options: UTC, Africa/Lagos, America/New_York, Europe/London, etc.
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=Africa/Lagos

# ============================================================================
# PHARMACY BUSINESS SETTINGS
# ============================================================================
# Pharmacy-specific configuration

# Pharmacy name (used in receipts, reports, UI)
PHARMACY_NAME=LizzyMike Pharmacy

# Pharmacy address (used in documents)
PHARMACY_ADDRESS=123 Main Street, Lagos, Nigeria

# Pharmacy phone (used in documents)
PHARMACY_PHONE=+234-123-456-7890

# Pharmacy license number (used in documents)
PHARMACY_LICENSE=License-123456

# Tax rate as decimal (0.03 = 3%)
PHARM_TAX_RATE=0.03

# Low stock warning threshold as percentage (0.2 = 20%)
# When stock falls below 20% of max qty, shows as "low"
LOW_STOCK_THRESHOLD=0.2

# How many months before expiry to warn (3 = warn 3 months before expiry)
EXPIRY_WARNING_MONTHS=3

# ============================================================================
# AWS S3 STORAGE (PRODUCTION ONLY - Optional)
# ============================================================================
# Store static files and media on S3 instead of the server
# Only used if DJANGO_ENV=production and USE_S3=True

USE_S3=False

# AWS credentials for S3 access
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3 bucket name where files will be stored
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name

# AWS region where your bucket is
AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# SENTRY ERROR TRACKING (PRODUCTION ONLY - Optional)
# ============================================================================
# Send errors to Sentry for monitoring and alerting
# Get DSN from: https://sentry.io

SENTRY_DSN=

# Sample rate for error tracking (0.0 to 1.0)
# 0.1 = sample 10% of errors (reduces quota usage)
# 1.0 = send all errors
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# EXAMPLE CONFIGURATIONS FOR EACH ENVIRONMENT
# ============================================================================

# --- DEVELOPMENT (Local Machine) ---
# DJANGO_ENV=development
# DEBUG=True
# SECRET_KEY=anything (insecure key is fine)
# DB_NAME=lizzymike_db (or sqlite is default)
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# JWT_ACCESS_LIFETIME=12
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- LAN PRODUCTION (Pharmacy Network) ---
# DJANGO_ENV=lan
# DEBUG=False
# SECRET_KEY=<generate-one>
# DB_NAME=lizzymike_db
# DB_USER=pharma_user
# DB_PASSWORD=<strong-password>
# DB_HOST=192.168.0.137
# DB_SSLMODE=allow
# ALLOWED_HOSTS=192.168.0.137,192.168.1.200,localhost
# CORS_ALLOWED_ORIGINS=http://192.168.0.137,http://localhost:3000
# JWT_ACCESS_LIFETIME=8
# TIME_ZONE=Africa/Lagos

# --- CLOUD PRODUCTION (e.g., Render, Railway) ---
# DJANGO_ENV=production
# DEBUG=False
# SECRET_KEY=<generate-one>
# DB_NAME=production_db
# DB_USER=prod_user
# DB_PASSWORD=<very-strong-password>
# DB_HOST=<provided-by-hosting>
# DB_PORT=5432
# DB_SSLMODE=require
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# JWT_ACCESS_LIFETIME=1
# REDIS_URL=<provided-by-hosting>
# CELERY_BROKER_URL=<provided-by-hosting>
# USE_S3=True
# AWS_ACCESS_KEY_ID=<your-key>
# AWS_SECRET_ACCESS_KEY=<your-secret>
# AWS_STORAGE_BUCKET_NAME=<your-bucket>
# SENTRY_DSN=<your-sentry-dsn>

# --- FREE HOSTING (e.g., Render Free, Railway Free) ---
# DJANGO_ENV=free
# DEBUG=False
# SECRET_KEY=<generate-one>
# DB_NAME=<provided-by-hosting>
# DB_USER=<provided-by-hosting>
# DB_PASSWORD=<provided-by-hosting>
# DB_HOST=<provided-by-hosting>
# DB_SSLMODE=require
# ALLOWED_HOSTS=yourdomain.onrender.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.onrender.com
# JWT_ACCESS_LIFETIME=12
# USE_S3=False
# REDIS_URL= (empty - uses LocMemCache)
# CELERY_BROKER_URL= (empty - tasks not supported)

################################################################################
# IMPORTANT SECURITY NOTES
################################################################################

# 1. NEVER commit Backend/.env to git
#    - It contains passwords and secret keys
#    - Use Backend/.env.example (this file) as template
#    - Add Backend/.env to .gitignore (already done)

# 2. Use STRONG passwords for database:
#    - 12+ characters
#    - Mix of uppercase, lowercase, numbers, symbols
#    - Examples: Secure@Pass#2024, LizzyMike$Pharma!2024

# 3. Different environments should have different credentials:
#    - Never reuse dev passwords in production
#    - Rotate passwords regularly
#    - Store production passwords securely (password manager, vault)

# 4. DJANGO_ENV determines security settings automatically:
#    - development: Very permissive (DEBUG=True, no SSL, all CORS origins)
#    - lan: HTTP on private network, strict CORS
#    - production: HTTPS required, strict headers, S3 support
#    - free: HTTPS required, LocMemCache only

# 5. SECRET_KEY is critical:
#    - Generate a new one for each environment
#    - Never share or commit it
#    - If compromised, rotate immediately and update all active sessions

# 6. When deploying to a new server:
#    - Create a new Backend/.env from Backend/.env.example
#    - Generate new SECRET_KEY
#    - Create new strong DB_PASSWORD
#    - Run: python manage.py migrate
#    - Run: python manage.py createsuperuser

################################################################################
