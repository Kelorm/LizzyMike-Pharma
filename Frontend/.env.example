# ============================================================================
# Frontend Environment Configuration - TEMPLATE
# ============================================================================
#
# PURPOSE:
#   This file shows all required environment variables for the React frontend.
#   DO NOT commit real values to git. Copy this file to .env.local and 
#   fill in YOUR actual values locally.
#
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env.local
#   2. Edit .env.local with your actual values (never commit it)
#   3. Frontend will automatically load .env.local on development
#   4. Make sure .env.local is in .gitignore (it should be)
#
# NOTE: Environment variables must start with REACT_APP_ to be accessible
# in React components via process.env.REACT_APP_*
#
# ============================================================================

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Backend API URL - where the React app sends requests
# Development: http://localhost:8000
# LAN: http://192.168.0.137:8000
# Production: https://api.yourdomain.com
REACT_APP_API_URL=http://localhost:8000

# API base path (usually /api)
REACT_APP_API_BASE_PATH=/api

# API timeout in milliseconds
REACT_APP_API_TIMEOUT=30000

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT token storage key (for localStorage)
REACT_APP_TOKEN_KEY=pharma_access_token

# Refresh token storage key
REACT_APP_REFRESH_TOKEN_KEY=pharma_refresh_token

# JWT token expiration time in minutes (usually 60)
REACT_APP_TOKEN_EXPIRY=60

# ============================================================================
# APPLICATION BRANDING
# ============================================================================

# Application name (displayed in header, title, etc.)
REACT_APP_NAME=LizzyMike Pharmacy

# Application description (used in meta tags, etc.)
REACT_APP_DESCRIPTION=Professional Pharmacy Management System

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable prescription digital signatures feature
REACT_APP_ENABLE_DIGITAL_SIGNATURES=true

# Enable PDF receipt generation
REACT_APP_ENABLE_PDF_RECEIPTS=true

# Enable audit trail view
REACT_APP_ENABLE_AUDIT_TRAIL=true

# Enable customer loyalty program
REACT_APP_ENABLE_LOYALTY_PROGRAM=true

# Enable inventory alerts
REACT_APP_ENABLE_INVENTORY_ALERTS=true

# Enable sales reporting
REACT_APP_ENABLE_SALES_REPORTS=true

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Debug mode (true/false) - shows verbose console logs
REACT_APP_DEBUG=false

# Log level (none, error, warn, info, debug)
REACT_APP_LOG_LEVEL=warn

# Enable network request logging
REACT_APP_LOG_REQUESTS=false

# ============================================================================
# UI/UX CONFIGURATION
# ============================================================================

# Items per page in data tables
REACT_APP_PAGE_SIZE=20

# Auto-refresh interval in milliseconds (0 to disable)
REACT_APP_AUTO_REFRESH_INTERVAL=60000

# Session timeout warning in milliseconds (15 minutes)
REACT_APP_SESSION_TIMEOUT=900000

# Inactivity timeout in milliseconds (30 minutes)
REACT_APP_INACTIVITY_TIMEOUT=1800000

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# Google Analytics tracking ID (if using)
REACT_APP_GA_TRACKING_ID=

# Sentry error tracking DSN (if using)
REACT_APP_SENTRY_DSN=

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

# Public URL path (for hosting on subdirectory)
PUBLIC_URL=/

# Build source maps (true/false) - makes debugging easier but larger bundle
GENERATE_SOURCEMAP=false

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================

# Environment type (development, staging, production)
REACT_APP_ENV=development

# Node environment (development, production)
NODE_ENV=development

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# CORS credentials (include/omit/same-origin)
REACT_APP_CREDENTIALS=include

# Content Security Policy enabled
REACT_APP_ENABLE_CSP=false

# ============================================================================
# PHARMACY SPECIFIC
# ============================================================================

# Default currency symbol
REACT_APP_CURRENCY=USD

# Decimal places for currency
REACT_APP_CURRENCY_DECIMALS=2

# Tax rate percentage (displayed as percentage, not decimal)
REACT_APP_TAX_RATE=3

# Default language
REACT_APP_LANGUAGE=en

# ============================================================================
# ADVANCED / OPTIONAL
# ============================================================================

# Maximum file upload size in MB
REACT_APP_MAX_UPLOAD_SIZE=10

# Enable offline mode
REACT_APP_ENABLE_OFFLINE=false

# Service worker enabled (for PWA/offline support)
REACT_APP_ENABLE_SERVICE_WORKER=false
